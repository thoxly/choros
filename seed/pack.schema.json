{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "seed/pack.schema.json",
  "title": "Choros Seed Pack",
  "description": "JSON Schema draft-07 for a Choros seed-pack (seed/<name>/pack.json). FF-1.",
  "type": "object",
  "required": ["meta", "tenant", "departments", "positions", "employees", "roles", "role_assignments", "grants", "rights_cards", "process_instances"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "version", "description"],
      "additionalProperties": false,
      "properties": {
        "name":        { "type": "string", "minLength": 1 },
        "version":     { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "tenant": {
      "type": "object",
      "required": ["slug", "display_name"],
      "additionalProperties": false,
      "properties": {
        "slug":         { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "departments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "display_name"],
        "additionalProperties": false,
        "properties": {
          "slug":         { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "parent_slug":  { "type": ["string", "null"] }
        }
      }
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "title", "department_slug"],
        "additionalProperties": false,
        "properties": {
          "slug":            { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title":           { "type": "string", "minLength": 1 },
          "department_slug": { "type": "string" }
        }
      }
    },
    "employees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "display_name", "kind"],
        "additionalProperties": false,
        "properties": {
          "slug":          { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "display_name":  { "type": "string", "minLength": 1 },
          "kind":          { "type": "string", "enum": ["human", "agent"] },
          "position_slug": { "type": ["string", "null"] }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "display_name", "system"],
        "additionalProperties": false,
        "properties": {
          "slug":         { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "description":  { "type": ["string", "null"] },
          "system":       { "type": "boolean" }
        }
      }
    },
    "role_assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["employee_slug", "role_slug", "org_scope"],
        "additionalProperties": false,
        "properties": {
          "employee_slug": { "type": "string" },
          "role_slug":     { "type": "string" },
          "org_scope":     { "type": "object" }
        }
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role_slug", "resource_type", "operation", "scope", "delegable"],
        "additionalProperties": false,
        "properties": {
          "role_slug":     { "type": "string" },
          "resource_type": { "type": "string", "minLength": 1 },
          "operation":     { "type": "string", "enum": ["create", "read", "update", "delete", "exec", "invoke"] },
          "scope":         { "type": "object" },
          "delegable":     { "type": "boolean" }
        }
      }
    },
    "rights_cards": {
      "type": "array",
      "description": "Display plane — served verbatim by GET /api/rights. FF-8: every role_slug MUST match roles[].slug.",
      "items": {
        "type": "object",
        "required": ["role_slug", "name", "dept", "scope", "holders", "grants", "fields"],
        "additionalProperties": false,
        "properties": {
          "role_slug": { "type": "string" },
          "name":      { "type": "string" },
          "dept":      { "type": "string" },
          "scope":     { "type": "string" },
          "holders": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "name"],
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["human", "agent", "service"] },
                "name": { "type": "string" }
              }
            }
          },
          "grants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["res", "uri", "ops", "scope"],
              "additionalProperties": false,
              "properties": {
                "res":   { "type": "string" },
                "uri":   { "type": "string" },
                "ops":   { "type": "array", "items": { "type": "string" } },
                "scope": { "type": "string" }
              }
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "a"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "a":    { "type": "string", "enum": ["read", "write", "hidden"] }
              }
            }
          }
        }
      }
    },
    "process_instances": {
      "type": "array",
      "description": "Display plane — served verbatim by GET /api/processes. Never written via API (I-1 documented exception, §2.4).",
      "items": {
        "type": "object",
        "required": ["id", "name", "procId", "status", "node", "started", "elapsed", "progress", "execs"],
        "additionalProperties": false,
        "properties": {
          "id":      { "type": "string" },
          "name":    { "type": "string" },
          "procId":  { "type": "string" },
          "status":  { "type": "string", "enum": ["running", "waiting", "done", "failed"] },
          "node":    { "type": "string" },
          "started": { "type": "string" },
          "elapsed": { "type": "string" },
          "progress": {
            "type": "object",
            "required": ["done", "total"],
            "additionalProperties": false,
            "properties": {
              "done":  { "type": "number" },
              "total": { "type": "number" }
            }
          },
          "execs": {
            "type": "array",
            "items": { "type": "string", "enum": ["human", "agent", "service"] }
          }
        }
      }
    }
  }
}
