{
  "realm": "choros",
  "displayName": "Choros (DEV ONLY — non-production dev fixture, RL-1)",
  "enabled": true,
  "accessTokenLifespan": 300,
  "resetPasswordAllowed": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "internationalizationEnabled": false,
  "clients": [
    {
      "clientId": "choros-api",
      "name": "Choros Core API",
      "description": "DEV ONLY — confidential client for the Choros core API server (resource server / audience source)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "secret": "choros-api-dev-secret",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8080"
      ],
      "attributes": {
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "actor-type-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "actor_type",
            "claim.name": "actor_type",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "choros-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "choros-web",
      "name": "Choros Web SPA",
      "description": "DEV ONLY — public PKCE SPA client for the browser frontend (T-0258). No secret: the browser uses Authorization Code + PKCE. Issues tokens with aud=choros-api + actor_type so the API guard accepts them.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
