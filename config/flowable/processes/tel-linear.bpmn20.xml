<?xml version="1.0" encoding="UTF-8"?>
<!--
  tel-linear.bpmn20.xml — T-0279 §A (ADR T-0278 §2.1) + T-0340 [E15-S5]
  Canonical ТЭЛ process definition with DMN-driven exclusiveGateway.

  Design constraints (ADR §2.1, NF O3):
  - T-0340 [E15-S5]: adds ONE exclusiveGateway (gw-approval-threshold) after
    the Триаж step, driven by the DMN-evaluated `approvalRequired` variable.
    Branch A ("needs-approval"): extra userTask «Доп. согласование» (U4-extra).
    Branch B ("standard"):       skip directly to endEvent «Завершено».
    The gateway variable is set via the A pre-compute path (dmn-gateway.ts) at
    the triage seam (completeTask for task-triage) before Flowable evaluates the
    exclusiveGateway. A mandatory late-compute also runs at the triage seam to
    avoid stale values.
  - Structure:
      startEvent → userTask «Подача заявки» → serviceTask «Триаж» (external)
      → exclusiveGateway [gw-approval-threshold, reads: approvalRequired]
        → (approvalRequired == "needs-approval") → userTask «Доп. согласование» → endEvent
        → (default / standard track)             → endEvent «Завершено»
  - userTask «Подача заявки»:     candidateGroups="role-initiator" (e-orlov, U1/U2)
  - serviceTask «Триаж»:          external topic="tel-intake" (a-intake, U3, DORMANT)
  - exclusiveGateway:             reads process variable `approvalRequired` (DMN F4)
  - userTask «Доп. согласование»: candidateGroups="role-approver" (e-larina, U4-extra)
  - Roles from seed/demo/tel-scenario.ts: same as before.

  Process key: telLinear  (camelCase per Flowable convention, like chorosSmoke)
  Deploy path: via deployBpmn REST (same as choros-smoke / customer-onboarding).
               NOT filesystem auto-deploy; NOT in seed-pack.
-->
<definitions
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:flowable="http://flowable.org/bpmn"
  targetNamespace="http://choros.io/tel"
  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
    http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">

  <process id="telLinear" name="Канонический линейный ТЭЛ" isExecutable="true">

    <!-- Start -->
    <startEvent id="start" name="Начало"/>

    <!-- UserTask 1: Подача заявки (инициатор, U1/U2) -->
    <userTask id="task-submit"
              name="Подача заявки"
              flowable:candidateGroups="role-initiator">
      <documentation>
        Инициатор (e-orlov, role-initiator) заполняет форму заявки:
        предмет, сумма (5.5M₽), обоснование. Серверная валидация через
        POST /api/forms/:formId/submit (E9). После submit: запись в record,
        процесс переходит к шагу Триажа.
        Соответствует шагам S1+S2 сценария tel-scenario.ts / U1+U2 ADR §2.1.
      </documentation>
    </userTask>

    <!-- ServiceTask: Триаж (внешняя задача, topic=tel-intake, DORMANT/DETERMINISTIC) -->
    <serviceTask id="task-triage"
                 name="Триаж"
                 flowable:type="external"
                 flowable:topic="tel-intake">
      <documentation>
        Агентский шаг (a-intake, role-intake-agent). External task, topic=tel-intake.
        agent_card DORMANT (llm_* NULL) — ZERO платных LLM (ADR NF3/O5, AC-10).
        На day-1 проходит детерминированно через fetchAndLock/completeTask
        (тот же bridge-механизм, что в choros-smoke). Не блокирует переход к U4.
        Соответствует шагу S3 (intake slot) сценария tel-scenario.ts / U3 ADR §2.1.
      </documentation>
    </serviceTask>

    <!-- ExclusiveGateway: DMN-driven approval threshold (T-0340 E15-S5) -->
    <!--
      Reads the `approvalRequired` process variable, which is set by the DMN
      pre-compute at the triage seam (src/core/dmn-gateway.ts + migration 080
      seed rule: amount > 5,000,000 ₽ → "needs-approval"; otherwise "standard").
      The A pre-compute path writes `approvalRequired` into completeTask variables
      before Flowable evaluates this gateway. A mandatory late-compute also runs
      at the triage seam to avoid stale values (F4 contract).
    -->
    <exclusiveGateway id="gw-approval-threshold" name="Нужно доп. согласование?">
      <documentation>
        Разветвление по результату DMN-оценки суммы заявки.
        Переменная: approvalRequired ("needs-approval" | "standard").
        Настраивается через таблицу решений dmn_rule_table (migration 066),
        засеянную migration 080 (порог 5 000 000 ₽).
      </documentation>
    </exclusiveGateway>

    <!-- UserTask: Доп. согласование (extra approver, U4-extra — needs-approval branch) -->
    <userTask id="task-extra-approve"
              name="Доп. согласование"
              flowable:candidateGroups="role-approver">
      <documentation>
        Дополнительное согласование для заявок свыше 5 000 000 ₽.
        Согласующий (role-approver, e-larina) берёт задачу из пула.
        Ветка: approvalRequired == "needs-approval".
      </documentation>
    </userTask>

    <!-- End -->
    <endEvent id="end" name="Завершено"/>

    <!-- Sequence flows -->
    <sequenceFlow id="sf-start-submit"   sourceRef="start"               targetRef="task-submit"/>
    <sequenceFlow id="sf-submit-triage"  sourceRef="task-submit"         targetRef="task-triage"/>
    <!-- Triage → gateway (DMN pre-compute sets approvalRequired before this transition) -->
    <sequenceFlow id="sf-triage-gw"      sourceRef="task-triage"         targetRef="gw-approval-threshold"/>
    <!-- Gateway branch: needs extra approval -->
    <sequenceFlow id="sf-gw-extra"       sourceRef="gw-approval-threshold" targetRef="task-extra-approve">
      <conditionExpression xsi:type="tFormalExpression">${approvalRequired == 'needs-approval'}</conditionExpression>
    </sequenceFlow>
    <!-- Gateway branch: standard track (default — no extra approval needed) -->
    <sequenceFlow id="sf-gw-end"         sourceRef="gw-approval-threshold" targetRef="end">
      <conditionExpression xsi:type="tFormalExpression">${approvalRequired == 'standard'}</conditionExpression>
    </sequenceFlow>
    <!-- Extra approval → end -->
    <sequenceFlow id="sf-extra-end"      sourceRef="task-extra-approve"  targetRef="end"/>

  </process>

</definitions>
