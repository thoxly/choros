# R-5: Prevent accidental tracking of server-side override file.
# On homeserver-vm /srv/choros/docker-compose.override.yml is untracked by design
# (holds restart: unless-stopped; survives git reset --hard). If staged accidentally
# the next deploy reset --hard would delete it, breaking the stack restart-policy.
docker-compose.override.yml

# T-0127 / T-0198 — activation secret discipline (RL-1/RL-3, NF-3).
# Only the vendor PUBLIC key (config/activation/vendor-pub.ed25519) is committed.
# The runtime activation.key and ANY private/secret key material never enter git.
# config/activation/ holds ONLY the public *.ed25519 anchor — every *.key there
# (the runtime activation.key) is a secret and stays out of git.
config/activation/*.key
# Private signing-key material anywhere in the tree (the vendor PRIVATE key must
# never enter the client circuit — key issuance is control-plane, OS-3).
*.private.key
*.priv.key
*-private.pem
*-priv.pem
*_private_key*
*.ed25519.priv
# The signed activation-key fixture under src/__tests__/fixtures/activation/ is a
# committed test artifact (a PUBLIC-verifiable wire string, not a secret) — keep it.
!src/__tests__/fixtures/activation/*.key
