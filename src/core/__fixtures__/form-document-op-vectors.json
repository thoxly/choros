      "expectedColumnsFieldKeys": ["c"],
      "expectedMovedFieldKeyAtRootEnd": "b"
    },
    {
      "name": "move field a into columns at index 0 (columns shifts to root[0] after removal)",
      "op": { "kind": "move", "fromPath": [0], "toPath": [1, 0] },
