# Choros prod env template (T-0061, E0.6)
#
# INSTRUCTIONS:
#   1. Copy this file to .env.prod (in the same directory as docker-compose.yml).
#   2. Replace ALL values that contain REPLACE_WITH_* with real, secure values.
#   3. NEVER commit .env.prod to git — it is in .gitignore (RL-3).
#   4. Run the prod stack:
#        docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#                       --env-file .env.prod up -d
#
# .env.prod is in .gitignore — NEVER commit it (RL-3).

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=choros
POSTGRES_USER=choros_migrator
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Host port for Postgres (optional override; default 55432)
# POSTGRES_PORT=55432

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN=choros_kc_admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Host ports (optional override)
# KEYCLOAK_PORT=8180
# KEYCLOAK_MGMT_PORT=9000

# --- Flowable ---------------------------------------------------------------
FLOWABLE_REST_APP_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Host port (optional override; default 8082)
# FLOWABLE_PORT=8082

# --- choros-app -------------------------------------------------------------
# DATABASE_URL: internal compose hostname 'postgres' (not localhost)
DATABASE_URL=postgres://choros_migrator:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/choros
CHOROS_AUTH_MODE=keycloak
PORT=3000
APP_PORT=3000

# --- Masking digest key -----------------------------------------------------
# Per-silo secret keying the data-classification `hash` transform (T-0118).
# 32+ random bytes (e.g. `openssl rand -hex 32`). If unset, fields that would be
# `hash`-masked are DROPPED (fail-closed) — never revealed, never keyless.
CHOROS_MASK_DIGEST_KEY=REPLACE_WITH_SECURE_HEX_KEY

# --- Activation key (OPTIONAL) — T-0127 -------------------------------------
# The activation key sells the vendor SERVICE layer (updates + agentic maintenance
# + support). It is NOT a kill-switch: if UNSET (or expired/invalid), the circuit
# comes up in AUTONOMOUS mode and is fully functional — only vendor-service calls
# refuse (402/403 on src/http/vendor-*). Leave commented for autonomous mode.
# The runtime key is also accepted via `ops/install.sh --key <path|wire>` and is
# written to config/activation/activation.key (gitignored). NEVER commit a real key.
# CHOROS_ACTIVATION_KEY=

# --- Notes ------------------------------------------------------------------
# POSTGRES_APP_PASSWORD: if T-0115 introduces a separate runtime role (choros_app),
# update DATABASE_URL above to use choros_app credentials at runtime.
# KC TLS / KC_PROXY=edge deferred to E0.7 (home-server provisioning).
